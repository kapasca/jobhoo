APP_ENV=development
PORT=8070

# Postgres connection string
DATABASE_URL=postgres://jobhoo:jobhoo_dev_password@localhost:5432/jobhoo?sslmode=disable

# Session/cookie signing secret — required in production
SESSION_SECRET=change-me-in-production

# AI provider: "mock" (default, no API key needed), "anthropic", or "openai" (stub)
AI_PROVIDER=mock
AI_API_KEY=
# Model used by the anthropic provider. Defaults to claude-3-5-sonnet-20241022 if unset.
AI_MODEL=

# Email configuration
# EMAIL_PROVIDER: "dev" (logs to console) or "smtp" (sends via SMTP server)
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@jobhoo.local

# SMTP configuration (used when EMAIL_PROVIDER=smtp)
# Example: Mailtrap, Gmail, SendGrid, AWS SES, or any SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
