APP_ENV=development
PORT=8070

# Postgres connection string
DATABASE_URL=postgres://jobhoo:jobhoo_dev_password@localhost:5432/jobhoo?sslmode=disable

# Session/cookie signing secret — required in production
SESSION_SECRET=change-me-in-production

# AI Configuration (OpenAI provider with Maia Router gateway)
AI_API_KEY=sk-Lk5-n63mw6G-pX9xu_jtKw
AI_MODEL=openai/gpt-5-nano
AI_BASE_URL=https://api.maiarouter.ai/v1

# Email configuration
# EMAIL_PROVIDER: "dev" (logs to console) or "smtp" (sends via SMTP server)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@jobhoo.local

# SMTP configuration (used when EMAIL_PROVIDER=smtp)
# Example: Mailtrap, Gmail, SendGrid, AWS SES, or any SMTP server
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=6ba9acbfe8608f
SMTP_PASS=3ea096ab9bd91e
