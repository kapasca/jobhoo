# ==============================================================================
# JOBHOO ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update the values for your environment.
# .env should NEVER be committed to git — it contains secrets!
# ==============================================================================

# Application Environment
APP_ENV=development          # development | production
PORT=8080                    # HTTP server port

# ==============================================================================
# DATABASE
# ==============================================================================
# For local development (direct connection to postgres on localhost):
DATABASE_URL=postgres://jobhoo:jobhoo_dev_password@localhost:5432/jobhoo?sslmode=disable

# For Docker Compose (use this when running: docker compose up):
# DATABASE_URL=postgres://jobhoo:jobhoo_dev_password@db:5432/jobhoo?sslmode=disable

# ==============================================================================
# SECURITY
# ==============================================================================
# Session/cookie signing secret
# In production: Generate a strong random value (e.g., openssl rand -base64 32)
SESSION_SECRET=change-me-in-production

# ==============================================================================
# AI CONFIGURATION
# ==============================================================================
# JOBHOO uses OpenAI provider exclusively. Configure it via:
# - AI_API_KEY: Your OpenAI API key or compatible gateway API key
# - AI_MODEL: Model identifier (e.g., gpt-4o, openai/gpt-5-nano)
# - AI_BASE_URL: Custom gateway URL (optional, defaults to OpenAI official API)
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-5-nano
# For custom gateways (e.g., Maia Router):
# AI_BASE_URL=https://api.maiarouter.ai/v1

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
# EMAIL_PROVIDER: dev | smtp
#   dev  = Log emails to console (no delivery)
#   smtp = Send via SMTP server (Mailtrap, Gmail, SendGrid, AWS SES, etc.)
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@jobhoo.local

# SMTP Server Configuration (used when EMAIL_PROVIDER=smtp)
# Leave empty for dev mode. Fill in for production/testing.
SMTP_HOST=                   # e.g., sandbox.smtp.mailtrap.io, smtp.gmail.com
SMTP_PORT=587                # e.g., 587 for TLS, 465 for SSL, 25 for plain
SMTP_USER=                   # e.g., your_email@gmail.com
SMTP_PASS=                   # e.g., app-specific password (NOT account password)

# ==============================================================================
# DEVELOPMENT NOTES
# ==============================================================================
# To use Mailtrap for testing (recommended):
#   1. Sign up free at mailtrap.io
#   2. Create a new inbox
#   3. Get SMTP credentials from Settings
#   4. Set EMAIL_PROVIDER=smtp and fill in SMTP_* fields
#   5. Emails will appear in your Mailtrap inbox
#
# Production checklist:
#   - Set APP_ENV=production
#   - Generate strong SESSION_SECRET
#   - Set EMAIL_PROVIDER=smtp with real SMTP service
#   - Update DATABASE_URL to production database
#   - Never commit .env to git
# ==============================================================================

