APP_ENV=development
PORT=8080

# Postgres connection string (for local direct connection)
# When running inside Docker, use: postgres://jobhoo:jobhoo_dev_password@db:5432/jobhoo?sslmode=disable
DATABASE_URL=postgres://jobhoo:jobhoo_dev_password@localhost:5432/jobhoo?sslmode=disable

# Session/cookie signing secret — required in production
SESSION_SECRET=change-me-in-production

# AI provider: "mock" (default, no API key needed), "anthropic", or "openai" (stub)
AI_PROVIDER=mock
AI_API_KEY=
# Model used by the anthropic provider. Defaults to claude-3-5-sonnet-20241022 if unset.
AI_MODEL=

# Email configuration
# EMAIL_PROVIDER: "dev" (logs) or "smtp"
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@jobhoo.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
