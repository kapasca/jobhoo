# Copy this file to .env and adjust as needed for local (non-Docker) runs.
# When running via `docker compose up`, these are already set in docker-compose.yml.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobhoo?sslmode=disable
PORT=8080
MIGRATIONS_DIR=migrations
TEMPLATES_DIR=web/templates
STATIC_DIR=web/static
UPLOAD_DIR=uploads
